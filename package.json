{
  "name": "murmur-midnight",
  "version": "0.1.0",
  "description": "Anonymous, verified feedback for teams on Midnight: only members can post, nobody can tell which member did.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contract/murmur.compact contract/managed/murmur",
    "compile:fast": "compact compile --skip-zk contract/murmur.compact contract/managed/murmur",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.8",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.4"
  }
}
